# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapbox (optional for local dev — falls back to mock map surface)
VITE_MAPBOX_ACCESS_TOKEN=

# Local/test only. Never enable payment simulation in production.
VITE_ENABLE_PAYMENT_SIMULATION=false

# Supabase Edge Function secrets (set with the Supabase CLI; never expose in Vite)
# APP_URL=https://your-production-domain.example
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# WORKER_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Capesee <bookings@your-domain.example>
